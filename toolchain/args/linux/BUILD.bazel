load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("//:directory.bzl", "expanded_headers_directory")

package(default_visibility = ["//visibility:public"])

expanded_headers_directory(
    name = "kernel_headers_expanded",
    directory = "@kernel_headers//:kernel_headers_directory",
)

expanded_headers_directory(
    name = "glibc_headers_expanded",
    directory = "//runtimes/glibc:glibc_headers_include_search_directory",
)

expanded_headers_directory(
    name = "sanitizer_headers_expanded",
    directory = "//sanitizers:sanitizers_headers_include_search_directory",
)

expanded_headers_directory(
    name = "musl_headers_expanded",
    directory = "//runtimes/musl:musl_headers_include_search_directory",
)

# Extracted from rules_cc unix_cc_configure.bzl
# TODO(cerisier): Extract those into proper semantic args list.
cc_args(
    name = "default_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-Wl,-no-as-needed",
        "-Wl,-z,relro,-z,now",
    ],
)

cc_args(
    name = "non_pie_executable_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_executable_actions",
    ],
    # Clang 22 defaults Linux links to PIE. Preserve Bazel's non-force_pic
    # executable semantics for GNU targets.
    args = select({
        "//platforms/config:gnu": ["-no-pie"],
        "//conditions:default": [],
    }),
    requires_none = "@rules_cc//cc/toolchains/variables:force_pic",
)

cc_args(
    name = "kernel_headers_include_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:source_compile_actions",
    ],
    allowlist_include_directories = [
        ":kernel_headers_expanded",
    ],
    args = [
        "-isystem",
        "{kernel_headers_include_search_path}",
    ],
    data = [
        ":kernel_headers_expanded",
    ],
    format = {
        "kernel_headers_include_search_path": ":kernel_headers_expanded",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "glibc_headers_include_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:source_compile_actions",
    ],
    allowlist_include_directories = [
        ":glibc_headers_expanded",
    ],
    args = [
        # "__GLIBC_MINOR__={d}", version.minor
        "-isystem",
        "{libc_headers_include_search_path}",
    ],
    data = [
        ":glibc_headers_expanded",
    ],
    format = {
        "libc_headers_include_search_path": ":glibc_headers_expanded",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "sanitizer_headers_include_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:source_compile_actions",
    ],
    allowlist_include_directories = [
        ":sanitizer_headers_expanded",
    ],
    # Make sure these sanitizer paths come after any user supplied paths, which
    # might also include another version of llvm's sanitizer headers.
    args = [
        "-Xclang",
        "-internal-isystem",
        "-Xclang",
        "{sanitizer_headers_include_search_paths}",
    ],
    data = [
        ":sanitizer_headers_expanded",
    ],
    format = {
        "sanitizer_headers_include_search_paths": ":sanitizer_headers_expanded",
    },
)

cc_args(
    name = "default_libs_gnu",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        # We need to support copts like -lc -ldl etc...
        "-L{libc_library_search_path}",

        # In prevention of when all of those can be shared libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",

        # Since libunwind is linked statically, we need to link pthread as well.
        "-lpthread",
        # Since libunwind is linked statically, we need to link dl as well.
        "-ldl",
        "-Wl,--pop-state",
    ],
    data = [
        "//runtimes/glibc:glibc_library_search_directory",
    ],
    format = {
        "libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory",
    },
)

###

cc_args(
    name = "musl_libc_headers_include_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:source_compile_actions",
    ],
    args = [
        "-isystem",
        "{libc_headers_include_search_path}",
    ],
    data = [
        ":musl_headers_expanded",
    ],
    format = {
        "libc_headers_include_search_path": ":musl_headers_expanded",
    },
)

#TODO: Factorize this and gnu
cc_args(
    name = "default_libs_musl",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        # We need to support copts like -lc -ldl etc...
        "-L{libc_library_search_path}",

        # In prevention of when all of those can be shared libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",

        # Since libunwind is linked statically, we need to link pthread as well.
        "-lpthread",
        # Since libunwind is linked statically, we need to link dl as well.
        "-ldl",
        "-Wl,--pop-state",
    ],
    data = [
        "//runtimes/musl:musl_library_search_directory",
    ],
    format = {
        "libc_library_search_path": "//runtimes/musl:musl_library_search_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
